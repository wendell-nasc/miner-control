#!/bin/bash

set -u

# ============================================================
# SRBMiner-MULTI 3.6.9
# Ubuntu 24.04.2
# CPU: AMD FX-8320
# Algoritmo: RandomSCash
# ============================================================

SRB_DIR="/home/wendell/SRBMiner/SRBMiner-Multi-3-6-9"
SRB_PATH="$SRB_DIR/SRBMiner-MULTI"

DOWNLOAD_URL="https://github.com/doktor83/SRBMiner-Multi/releases/download/3.6.9/SRBMiner-Multi-3-6-9-Linux.tar.gz"
ARCHIVE="$SRB_DIR/SRBMiner-Multi-3-6-9-Linux.tar.gz"

# ============================================================
# LOGS
# ============================================================

MOEDA1_LOGFILE="/var/log/SRBMOEDA1.log"
ENV_LOGFILE="/var/log/start-env.log"
ERROR_LOGFILE="/var/log/error.log"

touch "$MOEDA1_LOGFILE"
touch "$ENV_LOGFILE"
touch "$ERROR_LOGFILE"

chmod 644 "$MOEDA1_LOGFILE"
chmod 644 "$ENV_LOGFILE"
chmod 644 "$ERROR_LOGFILE"

# ============================================================
# AMBIENTE
# ============================================================

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

echo "==================================================" >> "$ENV_LOGFILE"
echo "$(date): Inicializando SRBMiner 3.6.9" >> "$ENV_LOGFILE"
echo "Hostname: $(hostname)" >> "$ENV_LOGFILE"
echo "Kernel: $(uname -r)" >> "$ENV_LOGFILE"
echo "CPU threads: $(nproc)" >> "$ENV_LOGFILE"
echo "==================================================" >> "$ENV_LOGFILE"

# ============================================================
# DOWNLOAD / INSTALAÇÃO
# ============================================================

if [ ! -x "$SRB_PATH" ]; then

    echo "$(date): SRBMiner 3.6.9 não encontrado. Instalando..." \
        >> "$ERROR_LOGFILE"

    mkdir -p "$SRB_DIR"

    cd "$SRB_DIR" || exit 1

    if [ ! -f "$ARCHIVE" ]; then

        wget -O "$ARCHIVE" "$DOWNLOAD_URL"

        if [ $? -ne 0 ]; then
            echo "$(date): ERRO ao baixar SRBMiner 3.6.9" \
                >> "$ERROR_LOGFILE"
            exit 1
        fi

    fi

    tar -xzf "$ARCHIVE" --strip-components=1

    if [ ! -f "$SRB_PATH" ]; then
        echo "$(date): ERRO: SRBMiner-MULTI não encontrado após extração" \
            >> "$ERROR_LOGFILE"
        exit 1
    fi

    chmod +x "$SRB_PATH"

    echo "$(date): SRBMiner 3.6.9 instalado com sucesso" \
        >> "$ENV_LOGFILE"
fi

# ============================================================
# CONFIGURAÇÃO DA MOEDA
# ============================================================

MOEDA1_POOL="stratum-na.rplant.xyz:7019"

MOEDA1_WALLET="scash1qvv3wfql4lxy36mkpgx3032nm4pvqmlq00lye6u"

MOEDA1_ALGO="randomscash"

WORKER="$(hostname)"

# ============================================================
# CPU
# ============================================================

TOTAL_THREADS=$(nproc)

# FX-8320 = 8 threads
CPU_THREADS="$TOTAL_THREADS"

echo "$(date): CPU threads disponíveis: $TOTAL_THREADS" \
    >> "$MOEDA1_LOGFILE"

echo "$(date): Usando $CPU_THREADS threads" \
    >> "$MOEDA1_LOGFILE"

# ============================================================
# INICIAR SRBMINER
# ============================================================

echo "" >> "$MOEDA1_LOGFILE"
echo "==================================================" >> "$MOEDA1_LOGFILE"
echo "$(date): Iniciando SRBMiner-MULTI 3.6.9" >> "$MOEDA1_LOGFILE"
echo "Algoritmo: $MOEDA1_ALGO" >> "$MOEDA1_LOGFILE"
echo "Pool: $MOEDA1_POOL" >> "$MOEDA1_LOGFILE"
echo "Worker: $WORKER" >> "$MOEDA1_LOGFILE"
echo "Threads: $CPU_THREADS" >> "$MOEDA1_LOGFILE"
echo "==================================================" >> "$MOEDA1_LOGFILE"

cd "$SRB_DIR" || exit 1

exec "$SRB_PATH" \
    --disable-gpu \
    --algorithm "$MOEDA1_ALGO" \
    --pool "$MOEDA1_POOL" \
    --wallet "$MOEDA1_WALLET" \
    --worker "$WORKER" \
    --cpu-threads "$CPU_THREADS" \
    --cpu-threads-priority 5 \
    --miner-priority 5 \
    --keepalive true \
    --log-file "$MOEDA1_LOGFILE" \
    --log-file-mode 1